# Copy to .env (never commit .env — it is gitignored)
POSTGRES_USER=nitu5
POSTGRES_PASSWORD=nitu5
POSTGRES_DB=nitu5
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nitu5:nitu5@localhost:5432/nitu5

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Files: S3Mock local now → R2 later (swap endpoint + keys, keep bucket name)
S3_ENDPOINT=http://localhost:9090
S3_BUCKET=nitu5
S3_REGION=us-east-1
S3_PORT=9090
# S3Mock accepts any credentials in dev:
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
# R2 later:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=xxx
# S3_SECRET_ACCESS_KEY=xxx

# Email: Mailpit local now → Resend later
SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# RESEND_API_KEY= (only when sending real mail)
# EMAIL_FROM="Nitu5 <no-reply@nitu5.com>"

# Providers (local defaults = free)
SMS_PROVIDER=console
MAP_PROVIDER=osm

API_PORT=3000
